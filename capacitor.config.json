{
  "appId": "app.lovable.3a09cb4d47944122821eea1465d0326d",
  "appName": "Relève d'Eau Mobile",
  "webDir": "dist",
  "server": {
    "androidScheme": "http",
    "cleartext": true,
    "allowNavigation": [
      "10.53.64.61",
      "10.53.64.61:*",
      "10.53.*.*",
      "192.168.*.*"
    ]
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "Camera": {
      "permissions": ["camera", "photos"]
    },
    "Geolocation": {
      "permissions": ["location"]
    }
  }
}
