# ─── Configuration SOAP SOMEI ────────────────────────────────────────────────
# Toutes ces variables sont OPTIONNELLES : elles définissent uniquement les
# valeurs par défaut au démarrage. L'utilisateur peut les surcharger depuis
# l'écran Profil > Configuration SOMEI (stockage localStorage).
#
# IMPORTANT : préfixe VITE_ obligatoire pour être injectées au build.
# Recharger `npm run build` après modification.

# URL de base du serveur SOMEI (sans slash final)
# Préférez HTTPS en production pour éviter les blocages Mixed Content du navigateur.
VITE_SOAP_BASE_URL=https://somei.exemple.local/rec

# URL explicite du WSDL (optionnel, sinon = ${VITE_SOAP_BASE_URL}/WSAcces.asmx?wsdl)
# VITE_SOAP_WSDL_URL=https://somei.exemple.local/rec/WSAcces.asmx?wsdl

# Identifiants pré-renseignés (optionnels — ne PAS committer de vraies valeurs)
# VITE_SOAP_CLIENT_ID=
# VITE_SOAP_ACCESS_KEY=
